{
  "manifest_version": 3,
  "name": "HumanType",
  "version": "1.0",
  "description": "Inject realistic human typing behavior into any text field",
  "action": {
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "sidePanel", "debugger"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png"
  }
}
