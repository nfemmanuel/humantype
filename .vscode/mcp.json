{
  "servers": {
    "iranti": {
      "type": "stdio",
      "command": "iranti",
      "args": [
        "mcp"
      ],
      "envFile": "${workspaceFolder}/.env.iranti",
      "env": {
        "IRANTI_MCP_DEFAULT_AGENT": "codex_code",
        "IRANTI_MCP_DEFAULT_SOURCE": "Codex",
        "IRANTI_MCP_HOST": "codex_vscode"
      }
    }
  }
}
